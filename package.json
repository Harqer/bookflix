{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "dev:mcp": "cross-env EXPO_UNSTABLE_MCP_SERVER=1 pnpm dev",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@clerk/clerk-expo": "^2.10.0",
    "@expo/vector-icons": "^15.0.3",
    "expo-linking": "~7.0.5",
    "expo-constants": "~17.0.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@sentry/react-native": "^8.9.2",
    "convex": "^1.36.1",
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-secure-store": "~15.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "nativewind": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "expo-mcp": "^0.2.4",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "utf-8-validate": "^5.0.2",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@clerk/types": "^4.101.21",
      "@clerk/clerk-react": "^5.61.3",
      "@clerk/shared": "^2.19.31",
      "@xmldom/xmldom": "^0.9.5",
      "glob": "^11.0.0",
      "rimraf": "^6.0.0",
      "inflight": "npm:lru-cache@^10.2.0",
      "uuid": "^11.0.0",
      "tar": "^7.4.3",
      "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.25.0",
      "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.25.0",
      "@babel/plugin-proposal-optional-chaining": "npm:@babel/plugin-transform-optional-chaining@^7.25.0",
      "@esbuild-kit/core-utils": "npm:tsx@^4.0.0",
      "@esbuild-kit/esm-loader": "npm:tsx@^4.0.0"
    }
  }
}
