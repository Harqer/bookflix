{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node", "convex"],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*"],
      "convex/react-clerk": ["./node_modules/convex/dist/esm-types/react-clerk/index.d.ts"],
      "convex/react": ["./node_modules/convex/dist/esm-types/react/index.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "convex", "vendor"]
}
