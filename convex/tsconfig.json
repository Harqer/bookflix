{
  /* This tsconfig.json is for the Convex backend functions. */
  "compilerOptions": {
    /* Standard Convex settings */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
